# ==============================================================================
# AgentGuard AI — Root .gitignore
# ==============================================================================

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Environment Variables & Secrets (NEVER commit secrets!)
.env
.env.*
!.env.example
*.pem
*.key
*.crt

# Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
nosetests.xml
coverage.xml

# Node.js & Next.js Frontend
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/dist/
frontend/.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Database & Celery / Redis
*.sqlite3
*.db
celerybeat-schedule
celerybeat.pid

# IDEs & Editors
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.swp
*.swo

# Temporary and Log files
*.log
logs/
tmp/
temp/
